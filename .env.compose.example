# Docker Compose reads .env from the repository root. Copy this file to .env
# before changing any defaults; do not commit the resulting file.

# Published ports bind to loopback by default. Set AOS_UI_BIND_ADDRESS=0.0.0.0
# only on a trusted private network, then use browser-reachable URLs/origins.
AOS_UI_BIND_ADDRESS=127.0.0.1
AOS_UI_WEB_PUBLISHED_PORT=3000

# Compose mounts this public configuration into the static web container.
# Fixture mode is the safe backend-free default. The browser's other mode is
# `aos`, which reaches the private normalized proxy; provider URLs stay there.
AOS_UI_RUNTIME_CONFIG_FILE=./deploy/runtime-config.fixture.json

# The OpenCode container stays non-root. On Linux, set these to the numeric
# output of `id -u` and `id -g` so it can write the repository bind mount and
# read mode-600 AWS files. The defaults suit hosts whose user/group IDs are 1000.
AOS_UI_HOST_UID=1000
AOS_UI_HOST_GID=1000

# Used only by the retained native OpenCode server-adapter overlay. The
# container mounts this external harness worktree at /workspace; it is not
# this UI checkout and is not a browser runtime.
AOS_UI_OPENCODE_WORKTREE=/absolute/path/to/opencode-worktree

# Native OpenCode adapter development only; these do not configure a browser
# runtime. Leave both values empty to let OpenCode select a model.
# AOS_UI_OPENCODE_PROVIDER_ID=amazon-bedrock
# AOS_UI_OPENCODE_MODEL_ID=your-model-id

# Compose mounts ${HOME}/.aws read-only by default. Use this when your AWS
# profile or SSO config lives elsewhere; credentials and region pass through.
# AOS_UI_AWS_CONFIG_DIR=/absolute/path/to/.aws
# AWS_PROFILE=your-profile
# AWS_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Google models. OpenCode reads GOOGLE_GENERATIVE_AI_API_KEY; the launcher also
# accepts GEMINI_API_KEY as an alias when the canonical variable is unset.
# GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_API_KEY=

# Optional OpenAI-compatible provider. All three are required together. It is
# exposed to OpenCode as provider "openai-compatible" and model "default".
# AOS_UI_OPENAI_COMPATIBLE_BASE_URL=https://models.example.test/v1
# AOS_UI_OPENAI_COMPATIBLE_API_KEY=replace-me
# AOS_UI_OPENAI_COMPATIBLE_MODEL_ID=upstream-model-id

# Hermes is operator-managed. Its native server must be reachable from the
# private proxy container; host loopback alone is not reachable through Docker.
# Copy deploy/proxy-config.hermes.example.json outside the checkout, customize
# its listener origins and Hermes address, and keep it owner-only.
# AOS_UI_PROXY_CONFIG_FILE=/absolute/private/path/proxy-config.json
# A single server token authenticates the shared Hermes runtime used by both
# the trusted operator listener and the optional scoped guest listener.
# AOS_UI_HERMES_TOKEN_FILE=/absolute/private/path/hermes-token
# AOS_UI_RECONNECT_CURSOR_KEY_FILE=/absolute/private/path/reconnect-cursor-key
# Guests use a separate port and scoped JWTs. Keep the signing key private; the
# guest origin and listener belong in the proxy config.
# AOS_UI_GUEST_INVITE_SIGNING_KEY_FILE=/absolute/private/path/guest-invite-signing-key
# AOS_UI_GUEST_BIND_ADDRESS=127.0.0.1
# AOS_UI_GUEST_PUBLISHED_PORT=3001
# Slash-command suggestions remain hidden in guest chat unless explicitly
# enabled. This is presentation only; typed commands still reach the runtime.
# AOS_UI_COMPOSER_SLASH_COMMANDS_ENABLED=false

# OpenCode proxy overlay. The public runtime config remains {"mode":"aos"};
# this private config selects the internal OpenCode service and its fixed
# workspace/Basic-auth identity. The password is mounted into both the proxy
# and native service as a file; never put the password value in this file.
# AOS_UI_RUNTIME_CONFIG_FILE=./deploy/runtime-config.opencode.json
# AOS_UI_PROXY_CONFIG_FILE=/absolute/private/path/proxy-config.opencode.json
# AOS_UI_OPENCODE_PASSWORD_FILE=/absolute/private/path/opencode-password

# OpenClaw proxy overlay. OpenClaw is independently operated and reachable
# from the proxy through the private ws/wss URL in proxy-config.openclaw.json.
# Device identity and token are mounted as owner-only files; do not pass a
# Gateway host, port, token, or device material to the browser environment.
# AOS_UI_RUNTIME_CONFIG_FILE=./deploy/runtime-config.openclaw.json
# AOS_UI_PROXY_CONFIG_FILE=/absolute/private/path/proxy-config.openclaw.json
# AOS_UI_OPENCLAW_DEVICE_IDENTITY_FILE=/absolute/private/path/openclaw-device-identity
# AOS_UI_OPENCLAW_DEVICE_TOKEN_FILE=/absolute/private/path/openclaw-device-token

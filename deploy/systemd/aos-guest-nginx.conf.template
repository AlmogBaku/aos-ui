# Install as a distinct virtual host for the guest domain. It deliberately has
# no native-runtime forwarding and no fallback to another AOS virtual host.
server {
  listen 443 ssl http2;
  server_name @GUEST_HOST@;

  # Configure certificates with this proxy's normal TLS mechanism.

  location ^~ /api/guest/ {
    proxy_pass http://127.0.0.1:@AOS_GATEWAY_GUEST_PORT@;
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location = / {
    proxy_pass http://127.0.0.1:@AOS_GATEWAY_GUEST_PORT@;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location = /runtime-config.json {
    proxy_pass http://127.0.0.1:@AOS_GATEWAY_GUEST_PORT@;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location = /logo-adaptive.svg {
    proxy_pass http://127.0.0.1:@AOS_GATEWAY_GUEST_PORT@;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location ^~ /assets/ {
    proxy_pass http://127.0.0.1:@AOS_GATEWAY_GUEST_PORT@;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location / { return 404; }
}

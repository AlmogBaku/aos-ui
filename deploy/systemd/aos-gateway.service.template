[Unit]
Description=AOS restricted guest gateway
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=aos-gateway
Group=aos-gateway
EnvironmentFile=/etc/aos-gateway/aos-gateway.env
LoadCredentialEncrypted=invite-signing-key:/etc/credstore.encrypted/aos-gateway-invite-key
LoadCredentialEncrypted=hermes-token:/etc/credstore.encrypted/aos-gateway-hermes-token
ExecStart=/bin/sh -ec 'export AOS_GATEWAY_INVITE_SIGNING_KEY="$(cat "$$CREDENTIALS_DIRECTORY/invite-signing-key")"; export AOS_GATEWAY_HERMES_TOKEN="$(cat "$$CREDENTIALS_DIRECTORY/hermes-token")"; exec /usr/local/bin/aos-gateway serve'
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/aos-gateway

[Install]
WantedBy=multi-user.target

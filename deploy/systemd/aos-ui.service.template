[Unit]
Description=AOS private operator UI
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=@AOS_CHECKOUT@
EnvironmentFile=/etc/aos-ui/aos-ui.env
# COMPOSE_FILE in /etc/aos-ui/aos-ui.env selects compose.yaml plus exactly one
# provider overlay (for example compose.hermes.yaml or compose.opencode.yaml).
# The selected overlay keeps native provider ports private to its network.
ExecStart=/usr/bin/docker compose --project-directory @AOS_CHECKOUT@ up --remove-orphans
ExecStop=/usr/bin/docker compose --project-directory @AOS_CHECKOUT@ down
Restart=always
RestartSec=5
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target

[Unit]
Description=AOS private operator UI
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=@AOS_CHECKOUT@
EnvironmentFile=/etc/aos-ui/aos-ui.env
# To enable Web Push (closed-app delivery), run deploy/setup-push.sh first,
# then add -f @AOS_CHECKOUT@/compose.push.yaml after the runtime overlay in
# all three Exec lines below.
# Replace @AOS_HOST_NETWORK@ (before @AOS_CHECKOUT@) with nothing for the
# bridged shape, or with -f @AOS_CHECKOUT@/deploy/compose.host.yaml for host
# networking; OpenCode then also needs
# -f @AOS_CHECKOUT@/deploy/compose.host.opencode.yaml after it.
ExecStart=/usr/bin/docker compose --project-directory @AOS_CHECKOUT@ \
  -f @AOS_CHECKOUT@/compose.yaml \
  -f @AOS_CHECKOUT@/compose.@AOS_RUNTIME@.yaml \
  @AOS_HOST_NETWORK@ \
  up --detach --build --remove-orphans --wait
ExecStop=/usr/bin/docker compose --project-directory @AOS_CHECKOUT@ \
  -f @AOS_CHECKOUT@/compose.yaml \
  -f @AOS_CHECKOUT@/compose.@AOS_RUNTIME@.yaml \
  @AOS_HOST_NETWORK@ \
  down
ExecReload=/usr/bin/docker compose --project-directory @AOS_CHECKOUT@ \
  -f @AOS_CHECKOUT@/compose.yaml \
  -f @AOS_CHECKOUT@/compose.@AOS_RUNTIME@.yaml \
  @AOS_HOST_NETWORK@ \
  up --detach --build --remove-orphans --wait
TimeoutStartSec=10min
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target

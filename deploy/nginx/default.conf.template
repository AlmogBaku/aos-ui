map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

server {
  listen ${AOS_UI_WEB_PORT};
  server_name _;
  root /usr/share/nginx/html;

  gzip on;
  gzip_min_length 1024;
  gzip_types application/javascript application/json image/svg+xml text/css;

  location = /api/health {
    default_type application/json;
    add_header Cache-Control "no-store" always;
    return 200 '{"status":"ok"}';
  }

  location = /runtime-config.json {
    default_type application/json;
    add_header Cache-Control "no-store" always;
    try_files $uri =404;
  }

  # The operator surface has one browser-to-server boundary. Native Hermes,
  # native auth, and provider WebSockets are never exposed as browser routes;
  # the private TypeScript proxy owns their translation and credentials.
  location = /api/aos/v1 {
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $aos_upstream http://${AOS_UI_PROXY_HOST}:${AOS_UI_PROXY_PORT};
    proxy_pass $aos_upstream;
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_cache off;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $http_host;
    proxy_set_header Origin $http_origin;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # The default AOS run body is bounded by the proxy at 1,100,000 bytes.
  # Keep Nginx at the same ceiling while allowing the larger media envelopes
  # only on their normalized, server-owned endpoints below.
  location /api/aos/v1/ {
    client_max_body_size 1100000;
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $aos_upstream http://${AOS_UI_PROXY_HOST}:${AOS_UI_PROXY_PORT};
    proxy_pass $aos_upstream;
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_cache off;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $http_host;
    proxy_set_header Origin $http_origin;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location ~ ^/api/aos/v1/agents/[^/]+/sessions/[^/]+/attachments/stage$ {
    client_max_body_size 35500000;
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $aos_upstream http://${AOS_UI_PROXY_HOST}:${AOS_UI_PROXY_PORT};
    proxy_pass $aos_upstream;
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_cache off;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $http_host;
    proxy_set_header Origin $http_origin;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location ~ ^/api/aos/v1/agents/[^/]+/sessions/[^/]+/audio/transcribe$ {
    client_max_body_size 7500000;
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $aos_upstream http://${AOS_UI_PROXY_HOST}:${AOS_UI_PROXY_PORT};
    proxy_pass $aos_upstream;
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_cache off;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $http_host;
    proxy_set_header Origin $http_origin;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location ~ ^/api/aos/v1/agents/[^/]+/sessions/[^/]+/audio/speak$ {
    client_max_body_size 40000;
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $aos_upstream http://${AOS_UI_PROXY_HOST}:${AOS_UI_PROXY_PORT};
    proxy_pass $aos_upstream;
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_cache off;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $http_host;
    proxy_set_header Origin $http_origin;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Never let legacy native/provider paths fall through to the SPA. Guest
  # traffic is served by its own origin and isolated listener.
  location = /auth { return 404; }
  location ^~ /auth/ { return 404; }
  location = /hermes { return 404; }
  location ^~ /hermes/ { return 404; }
  location = /openclaw { return 404; }
  location ^~ /openclaw/ { return 404; }

  location ^~ /api/ {
    default_type application/json;
    add_header Cache-Control "no-store" always;
    return 404 '{"error":"not_found"}';
  }

  location ^~ /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  location = /index.html {
    add_header Cache-Control "no-cache" always;
    try_files $uri =404;
  }

  location ~* \.[^/]+$ {
    try_files $uri =404;
  }

  location / {
    try_files $uri $uri/ @spa;
  }

  location @spa {
    add_header Cache-Control "no-cache" always;
    rewrite ^ /index.html break;
  }
}

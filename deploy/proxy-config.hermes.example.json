{
  "version": 1,
  "listen": {
    "host": "0.0.0.0",
    "port": 3000,
    "exposure": "private-container"
  },
  "publicOrigin": "http://127.0.0.1:3000",
  "operator": {
    "issuer": "https://identity.example.test",
    "clientId": "aos-ui",
    "clientSecretFile": "/run/secrets/oidc-client-secret",
    "principalHmacKeyFile": "/run/secrets/operator-principal-hmac",
    "redirectUri": "http://127.0.0.1:3000/api/aos/v1/auth/operator/callback",
    "allowedSubjects": ["operator@example.test"],
    "session": {
      "deploymentId": "aos-hermes-local",
      "keys": [
        {
          "id": "current",
          "secretFile": "/run/secrets/operator-session-key"
        }
      ],
      "ttlSeconds": 900
    }
  },
  "hermes": {
    "baseUrl": "http://host.docker.internal:9119",
    "auth": {
      "mode": "browser-broker",
      "callbackUrl": "http://127.0.0.1:3000/api/aos/v1/auth/runtime/upstream/auth/callback",
      "allowedIdentityOrigins": ["https://identity.example.test"]
    }
  },
  "events": {
    "activeKeyId": "current",
    "keys": [
      {
        "id": "current",
        "secretFile": "/run/secrets/reconnect-cursor-key"
      }
    ]
  },
  "guest": {
    "listen": {
      "host": "0.0.0.0",
      "port": 3001,
      "exposure": "private-container"
    },
    "publicOrigin": "https://guest.example.test",
    "hermes": {
      "baseUrl": "http://host.docker.internal:9119",
      "tokenFile": "/run/secrets/guest-hermes-token"
    },
    "invitations": {
      "keys": [
        {
          "id": "current",
          "secretFile": "/run/secrets/guest-invite-signing-key"
        }
      ],
      "ttlSeconds": 300,
      "clockSkewSeconds": 0
    }
  },
  "shutdownGraceMs": 5000
}

{
  "version": 1,
  "deploymentId": "aos-opencode-local",
  "listen": {
    "host": "0.0.0.0",
    "port": 3000,
    "exposure": "private-container"
  },
  "publicOrigin": "http://127.0.0.1:3000",
  "runtime": {
    "id": "opencode-default",
    "kind": "opencode",
    "baseUrl": "http://opencode:4096",
    "directory": "/workspace",
    "username": "aos-ui",
    "passwordFile": "/run/secrets/opencode-password"
  },
  "events": {
    "activeKeyId": "current",
    "keys": [
      {
        "id": "current",
        "secretFile": "/run/secrets/reconnect-cursor-key"
      }
    ]
  },
  "guest": {
    "listen": {
      "host": "0.0.0.0",
      "port": 3001,
      "exposure": "private-container"
    },
    "publicOrigin": "http://127.0.0.1:3001",
    "invitations": {
      "keys": [
        {
          "id": "current",
          "secretFile": "/run/secrets/guest-invite-signing-key"
        }
      ],
      "ttlSeconds": 259200,
      "clockSkewSeconds": 0
    }
  },
  "limits": {
    "activeExecutions": 256,
    "guestActiveExecutions": 32,
    "operatorEventPeers": 256,
    "subscriberEvents": 512,
    "subscriberBytes": 2097152
  },
  "shutdownGraceMs": 5000
}

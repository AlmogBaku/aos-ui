{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["bun", "node"]
  },
  "include": ["integrations/**/*.ts", "test/opencode/**/*.ts"],
  // The plugin entry and its contract test resolve OpenClaw's plugin SDK, a
  // peer this checkout does not install; `bun run openclaw:test` type-checks
  // and runs them under the package's own lockfile.
  "exclude": [
    "integrations/openclaw/index.ts",
    "integrations/openclaw/plugin.test.ts"
  ]
}

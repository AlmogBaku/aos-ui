# AOS and OpenCode already use these defaults. Copy this file to
# .env.local only when you need to override your shell environment.
AOS_UI_RUNTIME_MODE=opencode
AOS_UI_OPENCODE_BASE_URL=http://127.0.0.1:4096
AOS_UI_OPENCODE_HOST=127.0.0.1
AOS_UI_OPENCODE_PORT=4096
AOS_UI_OPENCODE_MANAGEMENT_PORT=4097
# Omit the management URL for an external provider without the AOS service.
AOS_UI_OPENCODE_MANAGEMENT_URL=http://127.0.0.1:4097

# OpenCode inherits AWS credentials from the shell, including an active SSO
# session. Uncomment these only when the desired profile/region are not already
# exported by your shell.
# AWS_PROFILE=your-profile
# AWS_REGION=eu-central-1

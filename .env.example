# Vite can read runtime configuration from a dedicated public JSON file.
# This is the preferred path because it matches production without exposing
# credentials. The file must contain only the allowlisted browser fields.
# AOS_UI_RUNTIME_CONFIG_FILE=/absolute/path/to/deploy/runtime-config.fixture.json

# For local convenience, Vite can derive the same public configuration from
# these non-secret environment values when no JSON file is specified.
AOS_UI_RUNTIME_MODE=opencode
AOS_UI_OPENCODE_BASE_URL=http://127.0.0.1:4096
AOS_UI_OPENCODE_WORKTREE=/absolute/path/to/opencode-worktree
AOS_UI_OPENCODE_HOST=127.0.0.1
AOS_UI_OPENCODE_PORT=4096

# Shared composer model/context controls are enabled by default. Set either
# value to false to hide that control independently when deriving public config.
# AOS_UI_COMPOSER_MODEL_SELECTOR_ENABLED=false
# AOS_UI_COMPOSER_CONTEXT_ENABLED=false

# Local Hermes alternative. Vite forwards HTTP/WebSocket and native auth routes.
# AOS_UI_RUNTIME_MODE=hermes
# AOS_UI_HERMES_BASE_URL=/hermes
# AOS_UI_HERMES_TARGET=http://127.0.0.1:9119
# Native Hermes requires authentication. Hermes owns recovery and auto-continue
# policy; AOS reattaches without submitting another prompt.

# Generic AG-UI requires separate run and workspace hosts.
# AOS_UI_RUNTIME_MODE=ag-ui
# AOS_UI_AG_UI_URL=http://127.0.0.1:8000/agent
# AOS_UI_AG_UI_WORKSPACE_URL=http://127.0.0.1:8001

# OpenCode inherits AWS credentials from the shell, including an active SSO
# session. Uncomment these only when the desired profile/region are not already
# exported by your shell.
# AWS_PROFILE=your-profile
# AWS_REGION=eu-central-1

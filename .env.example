# Vite reads public browser configuration from this JSON file. It must never
# contain provider URLs or credentials.
# AOS_UI_RUNTIME_CONFIG_FILE=/absolute/path/to/deploy/runtime-config.hermes.json

# The browser defaults to the harness-gw gateway. Fixture is the only local
# alternative, for deterministic interface work without a gateway.
AOS_UI_RUNTIME_MODE=aos
# AOS_UI_RUNTIME_MODE=fixture

# Vite forwards only the gateway's /api/v1 surface during local development.
# Run the gateway from its own checkout (harness-gw's `bun run serve`).
AOS_UI_GATEWAY_TARGET=http://127.0.0.1:4100

# Shared composer model/context controls are enabled by default.
# AOS_UI_COMPOSER_MODEL_SELECTOR_ENABLED=false
# AOS_UI_COMPOSER_CONTEXT_ENABLED=false

# `bun run opencode:serve` registers the UI's tools MCP server (started with
# `bun run tools-mcp:serve`) as the `aos-ui` remote MCP server. Override the URL
# when it listens elsewhere.
# AOS_UI_TOOLS_MCP_URL=http://127.0.0.1:4110/mcp

# Vite reads public browser configuration from this JSON file. It must never
# contain provider URLs or credentials.
# AOS_UI_RUNTIME_CONFIG_FILE=/absolute/path/to/deploy/runtime-config.hermes.json

# The browser defaults to the normalized AOS proxy. Fixture is the only local
# alternative, for deterministic interface work without a proxy.
AOS_UI_RUNTIME_MODE=aos
# AOS_UI_RUNTIME_MODE=fixture

# Vite forwards only the normalized proxy surface during local development.
AOS_UI_PROXY_TARGET=http://127.0.0.1:4100

# `bun run proxy:serve` without --config discovers
# ${XDG_CONFIG_HOME:-$HOME/.config}/aos-ui/proxy.yaml. Point this at an absolute
# private YAML file to override that discovery.
# AOS_UI_PROXY_CONFIG_FILE=/absolute/path/proxy.yaml

# Shared composer model/context controls are enabled by default.
# AOS_UI_COMPOSER_MODEL_SELECTOR_ENABLED=false
# AOS_UI_COMPOSER_CONTEXT_ENABLED=false

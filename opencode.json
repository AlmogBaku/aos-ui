{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "render_chart": "allow",
    "render_map": "allow",
    "render_stats": "allow",
    "present_plan": "allow",
    "monty_execute": "allow",
    "monty_search": "allow",
    "create_agent": "deny"
  },
  "mcp": {
    "monty": {
      "type": "local",
      "command": [
        "uv",
        "run",
        "--project",
        "integrations/monty",
        "--frozen",
        "python",
        "-m",
        "monty"
      ],
      "enabled": true,
      "timeout": 120000
    }
  }
}

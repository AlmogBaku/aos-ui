{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "types": [
      "node",
      "vite/client",
      "vitest/globals",
      "@testing-library/jest-dom/vitest"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "shared/**/*.ts",
    "e2e/**/*.ts",
    "test/containers/**/*.ts",
    "test/architecture/**/*.ts",
    "playwright*.config.ts",
    "vitest.config.ts"
  ]
}

{
  "name": "@aos-ui/openclaw-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "exports": "./dist/index.js",
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "bun build ./index.ts --outdir dist --target node --format esm --external openclaw",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "typebox": "1.3.30",
    "zod": "4.5.4"
  },
  "peerDependencies": {
    "openclaw": "2026.9.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "openclaw": "2026.9.4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}

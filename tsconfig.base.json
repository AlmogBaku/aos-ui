{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["./shared/*"],
      "@aos/protocol/acp": ["./packages/protocol/acp.ts"],
      "@aos/protocol/push": ["./packages/protocol/push.ts"],
      "@aos/protocol/mcp-apps": ["./packages/protocol/mcp-apps.ts"],
      "@aos/protocol": ["./packages/protocol/index.ts"]
    }
  }
}

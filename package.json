{
  "name": "aos-ui",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "opencode:serve": "bun run scripts/opencode-serve.ts",
    "proxy:serve": "bun run packages/proxy/cli.ts",
    "static:serve": "bun run packages/proxy/static-cli.ts",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3000",
    "integrations:build": "bun run scripts/build-integrations.ts",
    "hermes:test": "uv run --project integrations/hermes --frozen pytest -q integrations/hermes/tests",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.shared.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.tools.json --noEmit && tsc -p tsconfig.integration.json --noEmit && tsc -p tsconfig.proxy.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "monty:sync": "uv sync --project integrations/monty --frozen",
    "monty:test": "uv run --project integrations/monty --frozen pytest -q integrations/monty/tests",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.59",
    "@ag-ui/core": "0.0.59",
    "@ag-ui/encoder": "0.0.59",
    "@assistant-ui/react": "0.15.18",
    "@assistant-ui/react-ag-ui": "0.0.58",
    "@assistant-ui/react-markdown": "0.14.14",
    "@base-ui/react": "^1.7.0",
    "@fontsource/michroma": "^5.3.0",
    "@opencode-ai/plugin": "1.18.29",
    "@shikijs/langs": "4.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "14.0.3",
    "hono": "4.13.5",
    "jose": "6.2.12",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.40.0",
    "mermaid": "11.17.2",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "react-markdown": "10.1.0",
    "react-router": "7",
    "react-shiki": "0.11.1",
    "recharts": "3.8.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "11.0.0",
    "shadcn": "^4.20.1",
    "supercluster": "^9.1.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.12",
    "unified": "11.0.5",
    "yaml": "2.9.0",
    "zod": "4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "9",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "^1.4.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}

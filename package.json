{
  "name": "aos-ui",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "opencode:serve": "bun run scripts/opencode-serve.ts",
    "web:serve": "bun run server/cli.ts",
    "tools-mcp:build": "bun run packages/tools-mcp/build-views.ts",
    "tools-mcp:serve": "bun run tools-mcp:build && bun run packages/tools-mcp/cli.ts --http",
    "tools-mcp:stdio": "bun run packages/tools-mcp/cli.ts --stdio",
    "build": "bun run tools-mcp:build && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3000",
    "integrations:build": "bun run scripts/build-integrations.ts",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.shared.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.tools.json --noEmit && tsc -p tsconfig.tools-mcp.json --noEmit && tsc -p tsconfig.tools-mcp-views.json --noEmit",
    "test": "vitest run --project !gate",
    "test:gate": "vitest run --project gate",
    "test:watch": "vitest --project !gate",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.8.0",
    "@assistant-ui/core": "0.3.27",
    "@assistant-ui/react": "0.15.28",
    "@assistant-ui/react-markdown": "0.14.21",
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/michroma": "^5.3.0",
    "@harness-gw/sdk": "0.4.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/core": "2.3.1",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/server": "2.3.1",
    "@pierre/diffs": "1.5.2",
    "@shikijs/langs": "4.5.0",
    "@tanstack/react-virtual": "^3.14.17",
    "ansi-to-react": "6.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "disposablestack": "1.1.8",
    "hast-util-to-html": "9.0.5",
    "lucide-react": "^1.55.0",
    "maplibre-gl": "6.14.0",
    "mdast-util-to-hast": "13.2.1",
    "mermaid": "12.1.0",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-router": "8.4.0",
    "react-shiki": "0.11.2",
    "recharts": "3.10.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "11.0.0",
    "shadcn": "^4.21.4",
    "shiki": "4.5.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.13",
    "unified": "11.0.5",
    "zod": "4.6.6",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@eslint/js": "10",
    "@playwright/test": "^1.64.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@statelyai/inspect": "0.7.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "^1.4.3",
    "@types/node": "^26",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.4",
    "yaml": "2.9.1"
  }
}

{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2024", "ESNext.Disposable"],
    "types": ["node", "vite/client"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "shared/**/*.ts",
    "shared/**/*.tsx",
    "scripts/**/*.ts",
    "server/**/*.ts",
    "test/**/*.ts",
    "e2e/**/*.ts",
    "*.config.ts",
    "vite.config.ts"
  ],
  "exclude": ["node_modules"]
}
